---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — LIAO Yudan" description="Contact LIAO Yudan.">
  <div class="container">
    <p class="section-header">Contact</p>
    <p class="intro">Best reached by email.</p>
    <ul class="contact-list">
      <li>
        <span class="label">Email</span>
        <a href="mailto:yudan33668@gmail.com">yudan33668@gmail.com</a>
      </li>
      <li>
        <span class="label">GitHub</span>
        <a href="https://github.com/reeseliao" target="_blank" rel="noopener noreferrer">
          github.com/reeseliao
        </a>
      </li>
      <li>
        <span class="label">X</span>
        <a href="https://x.com/reeseintheloop" target="_blank" rel="noopener noreferrer">
          @reeseintheloop
        </a>
      </li>
    </ul>
  </div>
</BaseLayout>

<style>
  .intro {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-list li {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    min-width: 5rem;
    letter-spacing: 0.05em;
  }

  .contact-list a {
    font-size: 0.875rem;
    color: var(--color-text);
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
    padding-bottom: 1px;
  }

  .contact-list a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
</style>
