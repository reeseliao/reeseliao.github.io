---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Reese Liao" description="Personal page of Reese Liao (LIAO Yudan).">
  <section class="container hero">

    <div class="hero-name-block">
      <h1 class="hero-name">Reese Liao</h1>
      <span class="hero-alias">LIAO Yudan</span>
    </div>

    <p class="hero-bio">
      Applied Computing undergraduate at HSUHK working on edge AI,
      on-device inference, and ML systems. Currently building hybrid
      edge-cloud AI pipelines at Solos Technology.
    </p>

    <ul class="hero-links">
      <li>
        <a href="https://github.com/reeseliao" target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </li>
      <li>
        <a href="https://x.com/reeseintheloop" target="_blank" rel="noopener noreferrer">
          X / Twitter
        </a>
      </li>
      <li>
        <a href="mailto:yudan33668@gmail.com">
          Email
        </a>
      </li>
    </ul>

    <div class="skills-divider"></div>

    <div class="skills">
      <p class="section-header">Skills</p>
      <dl class="skill-groups">
        <div class="skill-group">
          <dt>Languages</dt>
          <dd>
            <span class="tag">Python</span>
            <span class="tag">C++</span>
            <span class="tag">Java</span>
            <span class="tag">SQL</span>
            <span class="tag">Markdown</span>
          </dd>
        </div>
        <div class="skill-group">
          <dt>Frameworks</dt>
          <dd>
            <span class="tag">PyTorch</span>
            <span class="tag">OpenVINO</span>
            <span class="tag">ONNX Runtime</span>
            <span class="tag">LiteRT</span>
            <span class="tag">HuggingFace</span>
            <span class="tag">Docker</span>
            <span class="tag">Linux</span>
            <span class="tag">Git</span>
            <span class="tag">n8n</span>
            <span class="tag">Streamlit</span>
            <span class="tag">Ollama</span>
            <span class="tag">Cloudflare Workers</span>
          </dd>
        </div>
        <div class="skill-group">
          <dt>Libraries</dt>
          <dd>
            <span class="tag">NumPy</span>
            <span class="tag">Pandas</span>
            <span class="tag">Scikit-learn</span>
            <span class="tag">OpenCV</span>
            <span class="tag">Open3D</span>
          </dd>
        </div>
        <div class="skill-group">
          <dt>Systems</dt>
          <dd>
            <span class="tag">BLE Stack (HCI/GATT)</span>
            <span class="tag">btsnoop</span>
            <span class="tag">IMU</span>
            <span class="tag">QAT</span>
            <span class="tag">PTQ</span>
          </dd>
        </div>
        <div class="skill-group">
          <dt>Spoken</dt>
          <dd>
            <span class="tag">English (IELTS 7.0)</span>
            <span class="tag">Mandarin (PSC Level 2A)</span>
            <span class="tag">Cantonese (Fluent)</span>
          </dd>
        </div>
      </dl>
    </div>

  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .hero-name-block {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .hero-name {
    font-family: var(--font-mono);
    font-size: 2.25rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .hero-alias {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .hero-bio {
    font-size: 1rem;
    color: var(--color-muted);
    max-width: 480px;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .hero-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-links a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text);
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease, color 0.15s ease;
    padding-bottom: 1px;
  }

  .hero-links a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .skills-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 3rem 0;
  }

  .skills .section-header {
    margin-bottom: 1.25rem;
  }

  .skill-groups {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .skill-group {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .skill-group dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-muted);
    min-width: 6rem;
    padding-top: 0.2rem;
    letter-spacing: 0.04em;
  }

  .skill-group dd {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 0.15rem 0.5rem;
  }

  @media (max-width: 520px) {
    .skill-group {
      flex-direction: column;
      gap: 0.5rem;
    }

    .skill-group dt {
      min-width: unset;
    }
  }
</style>
