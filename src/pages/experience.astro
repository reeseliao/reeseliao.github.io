---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceItem from '../components/ExperienceItem.astro';

const experience = [
  {
    role: 'Open-Source Contributor',
    org: 'SGLang',
    period: 'Nov 2026 – Present',
    bullets: [
      'Submitted upstream PR #49580 (under review) to the SGLang scheduler, fixing pause_generation(mode="abort") returning before the engine was idle — which caused the release_memory_occupation call that RL training loops make right after it to be refused.',
      'Traced the root cause to a running request aborted by a client disconnect, which frees its KV cache only at its next step; made abort mode pause and retract the scheduler, ordered ahead of abort_all on the same channel across the tokenizer manager and multi-tokenizer router.',
      'Added unit tests on both the scheduler side (engine fully idle after pause + abort) and the tokenizer side (pause dispatched before abort_all), and updated the RL integration docs to state the new contract.',
    ],
  },
  {
    role: 'Software Engineering Intern',
    org: 'Solos Technology · Hong Kong Science Park',
    period: 'May 2026 – Aug 2026',
    bullets: [
      'Conducted systematic benchmarking and profiling of sub-billion parameter lightweight LLMs/SLMs under strict smart glasses edge constraints, evaluating memory footprints, inference latency, and schema compliance to establish deployment trade-offs.',
      'Integrated PaddleOCR V5 into an automated business card extraction workflow, engineering async polling and schema-guided prompt pipelines to enhance OCR reliability in low-contrast, CJK-heavy scenarios.',
      'Built analytical pipelines for wearable device telemetries, isolating critical hardware failure modes to guide cross-functional firmware and hardware reliability enhancements.',
      // 'Designed and shipped automatic session-splitting for the datalog analysis pipeline, enabling multi-session CSVs from internal QA tooling to be analysed correctly.',
    ],
  },
  {
    role: 'Open-Source Contributor',
    org: 'Intel OpenVINO Toolkit',
    period: 'Feb 2026 – Present',
    bullets: [
      'Landed upstream PR #34577 (merged Oct 2026) in the OpenVINO PyTorch frontend, adding conversion support for aten::_fake_quantize_learnable_per_channel_affine across the TorchScript and FX / torch.export paths — unblocking QAT models with learnable quantization parameters (resolves issue #29682).',
      'Diagnosed low-level performance bottlenecks in the asynchronous execution pipeline, focusing on hardware-specific routing for edge inference targets.',
    ],
  },
  {
    role: 'Research Assistant — 3D Point Cloud Optimization',
    org: 'Autonomous Driving Perception Lab',
    period: 'Mar 2025 – Sep 2025',
    bullets: [
      'Investigated point cloud transmission and compression strategies for autonomous driving perception pipelines.',
      'Extended PointNet++ with a binary segmentation head for foreground/background classification, trained and evaluated on KITTI and V2X datasets.',
    ],
  },
];
---

<BaseLayout title="Experience — Reese Liao" description="Experience of Reese Liao.">
  <div class="container">
    <p class="section-header">Experience</p>
    <div class="timeline">
      {experience.map((e) => (
        <ExperienceItem
          role={e.role}
          org={e.org}
          period={e.period}
          bullets={e.bullets}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .timeline {
    position: relative;
    padding-left: 1rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0.35rem;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }
</style>
