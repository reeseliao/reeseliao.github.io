---
const pathname = Astro.url.pathname;
const navLinks = [
  { href: '/projects', label: 'Projects' },
  { href: '/experience', label: 'Experience' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];
---

<nav class="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-brand">LIAO Yudan</a>
    <ul class="nav-links">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={['nav-link', { active: pathname.startsWith(href) }]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">●</button>
  </div>
</nav>

<script>
  const toggle = document.getElementById('theme-toggle')!;

  function applyTheme(theme: string) {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem('theme', theme);
    toggle.textContent = theme === 'dark' ? '○' : '●';
    toggle.title = theme === 'dark' ? 'Switch to light' : 'Switch to dark';
  }

  // sync button label to current theme on load
  const current = document.documentElement.dataset.theme ?? 'light';
  toggle.textContent = current === 'dark' ? '○' : '●';
  toggle.title = current === 'dark' ? 'Switch to light' : 'Switch to dark';

  toggle.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    applyTheme(next);
  });
</script>

<style>
  .nav {
    border-bottom: 1px solid var(--color-border);
    padding: 1.25rem 0;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-brand {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-accent);
    letter-spacing: 0.02em;
  }

  .nav-brand:hover {
    color: var(--color-accent);
    opacity: 0.75;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent);
  }

  .theme-toggle {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-muted);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 0 0 1.5rem;
    line-height: 1;
    transition: color 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
  }
</style>
